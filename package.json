{
  "name": "aftercare-muj-podiatrist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4173 --bind 127.0.0.1",
    "test": "node --test tests/domain.test.js tests/csv.test.js",
    "test:browser": "playwright test",
    "pilot": "node --env-file-if-exists=.env pilot/server.js",
    "test:pilot": "node --test tests/pilot.test.js",
    "test:pilot:browser": "playwright test --config=pilot/playwright.config.js",
    "test:pilot:ai": "node --env-file-if-exists=.env pilot/verify-ai.js",
    "cloud:assets": "node cloud/build-assets.js",
    "cloud:dev": "npm run cloud:assets && wrangler dev",
    "cloud:deploy": "npm run cloud:assets && wrangler deploy",
    "cloud:set-login": "node cloud/set-login.js",
    "test:cloud": "node --test tests/cloud.test.js"
  },
  "dependencies": {
    "nodemailer": "^10.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "wrangler": "^4.0.0"
  }
}
