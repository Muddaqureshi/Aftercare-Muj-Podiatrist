{
  "name": "aftercare-muj-podiatrist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4173 --bind 127.0.0.1",
    "test": "node --test tests/domain.test.js tests/csv.test.js",
    "test:browser": "playwright test",
