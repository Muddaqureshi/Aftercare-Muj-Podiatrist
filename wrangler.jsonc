{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aftercare-muj-podiatrist",
  "main": "cloud/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./cloud/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "aftercare-fictional",
    "database_id": "d3da00bd-cb5f-44e1-ae35-9bde9f2e3ddc",
    "migrations_dir": "cloud/migrations"
  }],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "APP_ORIGIN": "https://aftercare-muj-podiatrist.muddq-finances.workers.dev",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "observability": { "enabled": false }
}
